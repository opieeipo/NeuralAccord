#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "Esegui esperimenti riproducibili sotto vincoli biologici dichiarati."

#: core/cli.py:40
msgid "LOCALE"
msgstr "LINGUA"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "Lingua dei messaggi, ad es. 'de' o 'zh-Hans'. Per impostazione predefinita, quella del tuo ambiente."

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "Esegui un esperimento biologico da una dichiarazione YAML versionata."

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "CONFIG"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "Seme da eseguire. Ripeti l'opzione per eseguire un elenco di semi."

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "Valuta il carico di calibrazione su una suddivisione cronologica tra sessioni."

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "Dichiarazione dell'esperimento: {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "Semi richiesti: {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "Nessun seme fornito; un risultato riportato richiede un elenco di semi, non una singola esecuzione migliore."

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "Errore di configurazione: {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "Livello di fedeltà dichiarato: {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "L'esecuzione non è ancora implementata. Questa release predispone soltanto il contratto di riproducibilità; vedi docs/validation.md per ciò che un risultato deve riportare prima di essere pubblicato."

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "Nessuna dichiarazione di esperimento in {path}."

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "{path} non è YAML valido: {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "{path} deve contenere una mappatura YAML al livello superiore."

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "In {path} manca un blocco 'experiment'."

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "Il blocco 'experiment' deve dichiarare un 'id'."

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "Livello di fedeltà sconosciuto {level!r}; atteso uno tra 0, 1, 2, 3, 4."

#~ msgid ""
