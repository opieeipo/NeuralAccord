#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "Pokreni ponovljive eksperimente pod deklarisanim biološkim ograničenjima."

#: core/cli.py:40
msgid "LOCALE"
msgstr "JEZIK"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "Jezik poruka, npr. 'de' ili 'zh-Hans'. Podrazumevano iz tvog okruženja."

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "Pokreni biološki eksperiment iz verzionisane YAML deklaracije."

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "KONFIG"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "Seme koje se pokreće. Ponovi opciju da pokreneš listu semena."

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "Proceni opterećenje kalibracije na hronološkoj podeli između sesija."

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "Deklaracija eksperimenta: {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "Zatražena semena: {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "Nije zadato seme; prijavljeni rezultat zahteva listu semena, a ne jedno najbolje pokretanje."

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "Greška u konfiguraciji: {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "Deklarisani nivo vernosti: {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "Izvršavanje još nije implementirano. Ovo izdanje samo postavlja okvir ugovora o ponovljivosti; pogledaj docs/validation.md za ono što rezultat mora da nosi pre nego što se prijavi."

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "Nema deklaracije eksperimenta na {path}."

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "{path} nije važeći YAML: {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "{path} mora da sadrži YAML mapiranje na najvišem nivou."

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "U {path} nedostaje blok 'experiment'."

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "Blok 'experiment' mora da deklariše 'id'."

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "Nepoznat nivo vernosti {level!r}; očekivan je jedan od 0, 1, 2, 3, 4."

