#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "Chạy các thí nghiệm có thể tái lập theo các ràng buộc sinh học đã khai báo."

#: core/cli.py:40
msgid "LOCALE"
msgstr "LOCALE"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "Ngôn ngữ của thông báo, ví dụ 'de' hoặc 'zh-Hans'. Mặc định lấy từ môi trường của bạn."

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "Chạy một thí nghiệm sinh học từ khai báo YAML có phiên bản."

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "CONFIG"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "Hạt giống cần chạy. Lặp lại tùy chọn để chạy một danh sách seed."

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "Đánh giá gánh nặng hiệu chuẩn trên phân tách liên phiên theo trình tự thời gian."

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "Khai báo thí nghiệm: {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "Số seed được yêu cầu: {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "Chưa cung cấp seed; một kết quả được báo cáo cần một danh sách seed, không phải một lần chạy tốt nhất."

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "Lỗi cấu hình: {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "Mức độ trung thực đã khai báo: {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "Việc thực thi chưa được triển khai. Bản phát hành này chỉ dựng khung cho hợp đồng tái lập; xem docs/validation.md để biết một kết quả phải kèm theo những gì trước khi được báo cáo."

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "Không có khai báo thí nghiệm tại {path}."

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "{path} không phải YAML hợp lệ: {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "{path} phải chứa một ánh xạ YAML ở cấp cao nhất."

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "{path} thiếu khối 'experiment'."

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "Khối 'experiment' phải khai báo 'id'."

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "Mức độ trung thực không xác định {level!r}; cần một trong 0, 1, 2, 3, 4."

