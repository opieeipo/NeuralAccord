#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "Запуск воспроизводимых экспериментов при заявленных биологических ограничениях."

#: core/cli.py:40
msgid "LOCALE"
msgstr "ЯЗЫК"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "Язык сообщений, например 'de' или 'zh-Hans'. По умолчанию — из твоего окружения."

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "Запуск биологического эксперимента из версионированного YAML-объявления."

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "КОНФИГ"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "Зерно для запуска. Повтори параметр, чтобы запустить список зёрен."

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "Оценка нагрузки на калибровку при хронологическом межсессионном разбиении."

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "Объявление эксперимента: {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "Запрошено зёрен: {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "Зерно не задано; публикуемый результат требует списка зёрен, а не одного лучшего запуска."

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "Ошибка конфигурации: {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "Заявленный уровень достоверности: {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "Выполнение ещё не реализовано. Этот выпуск лишь задаёт каркас контракта воспроизводимости; см. docs/validation.md о том, что должен нести результат, прежде чем его можно публиковать."

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "По пути {path} нет объявления эксперимента."

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "{path} не является корректным YAML: {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "{path} должен содержать YAML-отображение на верхнем уровне."

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "В {path} отсутствует блок 'experiment'."

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "Блок 'experiment' должен объявлять 'id'."

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "Неизвестный уровень достоверности {level!r}; ожидается один из 0, 1, 2, 3, 4."

