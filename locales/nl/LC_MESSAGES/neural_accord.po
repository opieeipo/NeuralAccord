#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "Voer reproduceerbare experimenten uit onder gedeclareerde biologische beperkingen."

#: core/cli.py:40
msgid "LOCALE"
msgstr "TAAL"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "Taal voor meldingen, bijv. 'de' of 'zh-Hans'. Standaard je omgeving."

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "Voer een biologisch experiment uit vanuit een geversioneerde YAML-declaratie."

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "CONFIG"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "Seed om uit te voeren. Herhaal de optie om een seedlijst uit te voeren."

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "Evalueer de kalibratielast op een chronologische splitsing tussen sessies."

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "Experimentdeclaratie: {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "Aangevraagde seeds: {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "Geen seed opgegeven; een gerapporteerd resultaat vereist een seedlijst, niet één beste run."

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "Configuratiefout: {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "Gedeclareerd fideliteitsniveau: {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "Uitvoering is nog niet geïmplementeerd. Deze release zet alleen het reproduceerbaarheidscontract op; zie docs/validation.md voor wat een resultaat moet bevatten voordat het gerapporteerd mag worden."

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "Geen experimentdeclaratie op {path}."

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "{path} is geen geldige YAML: {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "{path} moet op het hoogste niveau een YAML-mapping bevatten."

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "In {path} ontbreekt een 'experiment'-blok."

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "Het 'experiment'-blok moet een 'id' declareren."

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "Onbekend fideliteitsniveau {level!r}; verwacht een van 0, 1, 2, 3, 4."

#~ msgid ""
#~ "Language for messages, e.g. 'de' or "
#~ "'pt-BR'. Defaults to your environment."
#~ msgstr ""

