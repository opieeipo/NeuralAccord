#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "รันการทดลองที่ทำซ้ำได้ภายใต้ข้อจำกัดทางชีววิทยาที่ประกาศไว้"

#: core/cli.py:40
msgid "LOCALE"
msgstr "LOCALE"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "ภาษาของข้อความ เช่น 'de' หรือ 'zh-Hans' ค่าเริ่มต้นมาจากสภาพแวดล้อมของคุณ"

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "รันการทดลองทางชีววิทยาจากการประกาศ YAML ที่มีเวอร์ชัน"

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "CONFIG"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "ซีดที่จะรัน ใส่ตัวเลือกนี้ซ้ำเพื่อรันรายการซีด"

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "ประเมินภาระการปรับเทียบบนการแบ่งข้ามเซสชันตามลำดับเวลา"

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "การประกาศการทดลอง: {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "ซีดที่ร้องขอ: {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "ไม่ได้ระบุซีด ผลลัพธ์ที่รายงานต้องใช้รายการซีด ไม่ใช่การรันที่ดีที่สุดเพียงครั้งเดียว"

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "ข้อผิดพลาดของการกำหนดค่า: {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "ระดับความสมจริงที่ประกาศไว้: {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "ยังไม่ได้พัฒนาส่วนการรันจริง รุ่นนี้วางโครงเฉพาะสัญญาความสามารถทำซ้ำเท่านั้น ดู docs/validation.md ว่าผลลัพธ์ต้องมีอะไรบ้างก่อนจึงจะรายงานได้"

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "ไม่พบการประกาศการทดลองที่ {path}"

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "{path} ไม่ใช่ YAML ที่ถูกต้อง: {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "{path} ต้องมีการแมป YAML ที่ระดับบนสุด"

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "{path} ไม่มีบล็อก 'experiment'"

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "บล็อก 'experiment' ต้องประกาศ 'id'"

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "ระดับความสมจริงที่ไม่รู้จัก {level!r} คาดว่าเป็นหนึ่งใน 0, 1, 2, 3, 4"

