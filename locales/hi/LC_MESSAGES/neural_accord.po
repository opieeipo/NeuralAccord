#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "घोषित जैविक बाधाओं के तहत पुनरुत्पादनीय प्रयोग चलाएँ।"

#: core/cli.py:40
msgid "LOCALE"
msgstr "LOCALE"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "संदेशों की भाषा, जैसे 'de' या 'zh-Hans'। डिफ़ॉल्ट रूप से आपका परिवेश।"

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "किसी संस्करणित YAML घोषणा से जैविक प्रयोग चलाएँ।"

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "CONFIG"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "चलाने के लिए सीड। सीड की सूची चलाने हेतु विकल्प दोहराएँ।"

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "कालानुक्रमिक क्रॉस-सेशन विभाजन पर अंशांकन भार का मूल्यांकन करें।"

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "प्रयोग घोषणा: {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "अनुरोधित सीड: {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "कोई सीड नहीं दी गई; प्रकाशित परिणाम के लिए सीड की सूची चाहिए, केवल एक सर्वोत्तम रन नहीं।"

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "कॉन्फ़िगरेशन त्रुटि: {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "घोषित निष्ठा स्तर: {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "निष्पादन अभी लागू नहीं किया गया है। यह रिलीज़ केवल पुनरुत्पादनीयता अनुबंध का ढाँचा बनाती है; परिणाम प्रकाशित करने से पहले उसमें क्या होना चाहिए, यह docs/validation.md में देखें।"

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "{path} पर कोई प्रयोग घोषणा नहीं है।"

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "{path} मान्य YAML नहीं है: {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "{path} में शीर्ष स्तर पर YAML मैपिंग होनी चाहिए।"

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "{path} में 'experiment' ब्लॉक नहीं है।"

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "'experiment' ब्लॉक में 'id' घोषित होना चाहिए।"

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "अज्ञात निष्ठा स्तर {level!r}; 0, 1, 2, 3, 4 में से एक अपेक्षित है।"

