#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "Exécuter des expériences reproductibles sous des contraintes biologiques déclarées."

#: core/cli.py:40
msgid "LOCALE"
msgstr "LANGUE"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "Langue des messages, par ex. 'de' ou 'zh-Hans'. Par défaut, celle de votre environnement."

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "Exécuter une expérience biologique à partir d'une déclaration YAML versionnée."

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "CONFIG"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "Graine à exécuter. Répétez l'option pour exécuter une liste de graines."

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "Évaluer la charge de calibration sur une partition chronologique inter-sessions."

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "Déclaration d'expérience : {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "Graines demandées : {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "Aucune graine fournie ; un résultat publié exige une liste de graines, et non une seule meilleure exécution."

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "Erreur de configuration : {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "Niveau de fidélité déclaré : {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "L'exécution n'est pas encore implémentée. Cette version ne met en place que le contrat de reproductibilité ; voir docs/validation.md pour ce qu'un résultat doit comporter avant d'être publié."

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "Aucune déclaration d'expérience à {path}."

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "{path} n'est pas un YAML valide : {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "{path} doit contenir un mappage YAML au niveau supérieur."

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "Il manque un bloc 'experiment' dans {path}."

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "Le bloc 'experiment' doit déclarer un 'id'."

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "Niveau de fidélité inconnu {level!r} ; attendu l'un de 0, 1, 2, 3, 4."

#~ msgid ""
#~ "Language for messages, e.g. 'de' or "
#~ "'pt-BR'. Defaults to your environment."
#~ msgstr ""

