#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "Magpatakbo ng mga eksperimentong nauulit sa ilalim ng idineklarang mga hangganang biyolohikal."

#: core/cli.py:40
msgid "LOCALE"
msgstr "WIKA"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "Wika ng mga mensahe, hal. 'de' o 'zh-Hans'. Bilang default, mula sa iyong kapaligiran."

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "Magpatakbo ng eksperimentong biyolohikal mula sa isang bersyonadong deklarasyong YAML."

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "CONFIG"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "Seed na patatakbuhin. Ulitin ang opsyon para magpatakbo ng listahan ng seed."

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "Suriin ang pasanin ng kalibrasyon sa isang kronolohikong hati sa pagitan ng mga sesyon."

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "Deklarasyon ng eksperimento: {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "Mga hiniling na seed: {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "Walang ibinigay na seed; ang iniuulat na resulta ay nangangailangan ng listahan ng seed, hindi ng isang pinakamahusay na takbo."

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "Error sa konpigurasyon: {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "Idineklarang antas ng fidelity: {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "Hindi pa naipapatupad ang aktwal na pagpapatakbo. Inihahanda lamang ng release na ito ang kontrata sa reproducibility; tingnan ang docs/validation.md kung ano ang dapat taglayin ng isang resulta bago ito iulat."

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "Walang deklarasyon ng eksperimento sa {path}."

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "Hindi wastong YAML ang {path}: {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "Dapat maglaman ang {path} ng YAML mapping sa pinakamataas na antas."

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "Kulang ang {path} ng blokeng 'experiment'."

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "Dapat magdeklara ng 'id' ang blokeng 'experiment'."

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "Hindi kilalang antas ng fidelity na {level!r}; inaasahan ang isa sa 0, 1, 2, 3, 4."

