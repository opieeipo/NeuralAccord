#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "宣言された生物学的制約のもとで再現可能な実験を実行します。"

#: core/cli.py:40
msgid "LOCALE"
msgstr "LOCALE"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "メッセージの言語（例: 'de'、'zh-Hans'）。既定では実行環境に従います。"

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "バージョン管理された YAML 宣言から生物実験を実行します。"

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "CONFIG"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "実行するシード。オプションを繰り返すとシードのリストを実行します。"

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "時系列のセッション間分割でキャリブレーション負荷を評価します。"

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "実験宣言: {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "要求されたシード数: {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "シードが指定されていません。報告する結果にはシードのリストが必要であり、最良の 1 回の実行では足りません。"

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "構成エラー: {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "宣言された忠実度レベル: {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "実行はまだ実装されていません。このリリースは再現性契約の骨組みのみを提供します。結果を報告する前に何が必要かは docs/validation.md を参照してください。"

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "{path} に実験宣言がありません。"

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "{path} は有効な YAML ではありません: {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "{path} の最上位は YAML マッピングでなければなりません。"

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "{path} に 'experiment' ブロックがありません。"

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "'experiment' ブロックは 'id' を宣言する必要があります。"

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "不明な忠実度レベル {level!r} です。0、1、2、3、4 のいずれかを指定してください。"

