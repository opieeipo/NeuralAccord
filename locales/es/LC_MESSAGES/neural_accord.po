#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "Ejecuta experimentos reproducibles bajo restricciones biológicas declaradas."

#: core/cli.py:40
msgid "LOCALE"
msgstr "IDIOMA"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "Idioma de los mensajes, p. ej. 'de' o 'zh-Hans'. Por defecto, el de tu entorno."

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "Ejecuta un experimento biológico a partir de una declaración YAML versionada."

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "CONFIG"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "Semilla que ejecutar. Repite la opción para ejecutar una lista de semillas."

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "Evalúa la carga de calibración en una partición cronológica entre sesiones."

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "Declaración del experimento: {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "Semillas solicitadas: {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "No se indicó ninguna semilla; un resultado publicado exige una lista de semillas, no una única mejor ejecución."

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "Error de configuración: {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "Nivel de fidelidad declarado: {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "La ejecución todavía no está implementada. Esta versión solo prepara el contrato de reproducibilidad; consulta docs/validation.md para saber qué debe acompañar a un resultado antes de publicarlo."

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "No hay ninguna declaración de experimento en {path}."

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "{path} no es YAML válido: {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "{path} debe contener un mapeo YAML en el nivel superior."

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "A {path} le falta un bloque 'experiment'."

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "El bloque 'experiment' debe declarar un 'id'."

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "Nivel de fidelidad desconocido {level!r}; se esperaba uno de 0, 1, 2, 3, 4."

#~ msgid ""
#~ "Language for messages, e.g. 'de' or "
