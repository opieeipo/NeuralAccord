#: core/cli.py:31
msgid "Run reproducible experiments under declared biological constraints."
msgstr "ঘোষিত জৈবিক সীমাবদ্ধতার অধীনে পুনরুৎপাদনযোগ্য পরীক্ষা চালান।"

#: core/cli.py:40
msgid "LOCALE"
msgstr "LOCALE"

#: core/cli.py:41
msgid ""
"Language for messages, e.g. 'de' or 'zh-Hans'. Defaults to your "
"environment."
msgstr "বার্তার ভাষা, যেমন 'de' বা 'zh-Hans'। ডিফল্টে আপনার পরিবেশ অনুসরণ করে।"

#: core/cli.py:48
msgid "Run a biological experiment from a versioned YAML declaration."
msgstr "একটি সংস্করণকৃত YAML ঘোষণা থেকে জৈবিক পরীক্ষা চালান।"

#: core/cli.py:50 core/cli.py:63
msgid "CONFIG"
msgstr "CONFIG"

#: core/cli.py:55 core/cli.py:68
msgid "N"
msgstr "N"

#: core/cli.py:56 core/cli.py:69
msgid "Seed to run. Repeat the option to run a seed list."
msgstr "যে সিড চালাতে হবে। সিডের তালিকা চালাতে অপশনটি পুনরাবৃত্তি করুন।"

#: core/cli.py:61
msgid "Evaluate calibration burden on a chronological cross-session split."
msgstr "কালানুক্রমিক ক্রস-সেশন বিভাজনে ক্যালিব্রেশন ভার মূল্যায়ন করুন।"

#: core/cli.py:77
#, python-brace-format
msgid "Experiment declaration: {path}"
msgstr "পরীক্ষার ঘোষণা: {path}"

#: core/cli.py:80
#, python-brace-format
msgid "Seeds requested: {count}"
msgstr "অনুরোধকৃত সিড: {count}"

#: core/cli.py:82
msgid "No seed given; a reported result requires a seed list, not one best run."
msgstr "কোনো সিড দেওয়া হয়নি; প্রতিবেদিত ফলাফলের জন্য সিডের তালিকা প্রয়োজন, একটিমাত্র সেরা রান নয়।"

#: core/cli.py:97
#, python-brace-format
msgid "Configuration error: {reason}"
msgstr "কনফিগারেশন ত্রুটি: {reason}"

#: core/cli.py:102
#, python-brace-format
msgid "Declared fidelity level: {level}"
msgstr "ঘোষিত ফিডেলিটি স্তর: {level}"

#: core/cli.py:106
msgid ""
"Execution is not implemented yet. This release scaffolds the "
"reproducibility contract only; see docs/validation.md for what a result "
"must carry before it can be reported."
msgstr "কার্যকর করা এখনও বাস্তবায়িত হয়নি। এই রিলিজ কেবল পুনরুৎপাদনযোগ্যতার চুক্তির কাঠামো তৈরি করে; প্রতিবেদনের আগে একটি ফলাফলে কী থাকতে হবে তা docs/validation.md-এ দেখুন।"

#: core/config.py:31
#, python-brace-format
msgid "No experiment declaration at {path}."
msgstr "{path}-এ কোনো পরীক্ষার ঘোষণা নেই।"

#: core/config.py:36
#, python-brace-format
msgid "{path} is not valid YAML: {reason}"
msgstr "{path} বৈধ YAML নয়: {reason}"

#: core/config.py:39
#, python-brace-format
msgid "{path} must contain a YAML mapping at the top level."
msgstr "{path}-এর শীর্ষ স্তরে একটি YAML ম্যাপিং থাকতে হবে।"

#: core/config.py:43
#, python-brace-format
msgid "{path} is missing an 'experiment' block."
msgstr "{path}-এ 'experiment' ব্লক নেই।"

#: core/config.py:46
msgid "The 'experiment' block must declare an 'id'."
msgstr "'experiment' ব্লকে অবশ্যই একটি 'id' ঘোষণা করতে হবে।"

#: core/config.py:51
#, python-brace-format
msgid "Unknown fidelity level {level!r}; expected one of 0, 1, 2, 3, 4."
msgstr "অজানা ফিডেলিটি স্তর {level!r}; 0, 1, 2, 3, 4-এর মধ্যে একটি প্রত্যাশিত।"

